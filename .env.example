# Dois Pontos - variáveis de ambiente (copie para .env e ajuste)

# API
NODE_ENV=development
PORT=3333
HOST=127.0.0.1

# Banco SQLite. Caminho relativo à pasta apps/api.
DATABASE_PATH=./data/dois-pontos.sqlite

# Fuso horário usado nas regras de recorrência e relatórios
APP_TIMEZONE=America/Sao_Paulo
